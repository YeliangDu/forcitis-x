{
  "name": "forcitis-x",
  "private": true,
  "version": "0.1.0-poc",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"packages/**/*.test.ts\"",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint packages scripts",
    "poc:p1": "node scripts/poc-p1-section.mts",
    "check": "npm run build && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.6.0"
  }
}
